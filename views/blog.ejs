<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blog</title>

        <style>
            #blogContent {
                background: linear-gradient(135deg, #ffffff, #f1f1f1);
            }

            body[data-theme="dark"] #blogContent {
                background: linear-gradient(135deg, #1e1e1e, #2a2a2a);
            }
        </style>
</head>

<body>
    <%- include('./partials/nav') %>

        <div class="container mt-5" style="max-width: 850px;">

            <!-- Title -->
            <h1 class="fw-bold text-center mb-3">
                <%= blog.title %>
            </h1>

            <!-- Author -->
            <p class="text-center text-muted mb-4">
                ✍️ <%= blog.createdBy?.fullName || "Unknown" %> •
                    <%= new Date(blog.createdAt).toDateString() %>
            </p>

            <!-- Image -->
            <img src="<%= blog.coverImage %>" class="w-100 rounded-4 shadow mb-4"
                style="height: 420px; object-fit: cover;" />

            <!-- Blog Content -->
            <div id="blogContent" class="p-4 rounded-4 shadow-sm" style="line-height: 1.9;">
                <%= blog.body %>
            </div>

            <!-- Author Info -->
            <div class="mt-4 d-flex align-items-center gap-2">
                <img src="<%= blog.createdBy.profileImage %>" width="50" class="rounded-circle">
                <strong>
                    <%= blog.createdBy.fullName %>
                </strong>
            </div>

            <!-- ================= COMMENTS SECTION ================= -->

            <div class="mt-5">

                <h4 class="mb-3">
                    💬 Comments (<%= comments.length %>)
                </h4>

                <!-- Comment Form (only if logged in) -->
                <% if (locals.user) { %>
                    <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-4">
                        <div class="mb-3">
                            <textarea class="form-control" name="content" placeholder="Write your comment..."
                                required></textarea>
                        </div>

                        <button class="btn btn-dark">Post Comment</button>
                    </form>
                    <% } else { %>
                        <p class="text-muted">
                            Please <a href="/user/signin">login</a> to comment.
                        </p>
                        <% } %>

                            <!-- Comments List -->
                            <div class="mt-3">

                                <% comments.forEach(comment=> { %>

                                    <div class="d-flex gap-3 mb-3 p-3 rounded shadow-sm"
                                        style="background: rgba(0,0,0,0.03);">

                                        <img src="<%= comment.createdBy.profileImage %>" width="45" height="45"
                                            class="rounded-circle">

                                        <div>
                                            <strong>
                                                <%= comment.createdBy.fullName %>
                                            </strong>

                                            <p class="mb-0" style="white-space: pre-wrap;">
                                                <%= comment.content %>
                                            </p>
                                        </div>

                                    </div>

                                    <% }) %>

                            </div>

            </div>

        </div>

        <%- include('./partials/scripts') %>
</body>

</html>